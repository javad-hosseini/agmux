# agmux - Remote Antigravity Telegram Agent Configuration

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token

# Required: Your personal Telegram numeric user ID (from @userinfobot)
ALLOWED_USER_ID=987654321

# Path to the Antigravity CLI binary
AGY_BIN=/home/javad/.local/bin/agy

# Base data directory for SQLite state.db and artifacts outbox
DATA_DIR=./data

# Projects allowlist JSON mapping slugs to local repo absolute paths
PROJECTS_FILE=./projects.json

# Optional: Base HTTP URL for viewing artifacts in browser (e.g. if served via Nginx/Tailscale)
# ARTIFACTS_BASE_URL=https://agmux.internal.lan/artifacts

